<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="SettingsMenu.uss" />
    <ui:VisualElement name="settings-root" class="settings-root" picking-mode="Ignore">
        <ui:Button name="open-settings" text="Settings" class="settings-button launcher" tooltip="Open settings (Esc / P)" />
        <ui:VisualElement name="settings-overlay" class="overlay">
            <ui:VisualElement class="settings-panel">
                <ui:VisualElement class="header">
                    <ui:Label name="settings-title" text="Settings" class="title" />
                    <ui:Button name="close-settings" text="×" class="settings-button close-button" tooltip="Save and resume" />
                </ui:VisualElement>
                <ui:ScrollView name="settings-scroll" class="settings-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden">
                    <ui:VisualElement name="settings-fields">
                        <ui:VisualElement class="slider-setting">
                            <ui:Slider name="volume" label="Master volume" low-value="0" high-value="1" class="setting-slider" tooltip="Volume of all game audio" />
                            <ui:Label name="volume-value" text="100%" class="slider-value" />
                        </ui:VisualElement>
                        <ui:DropdownField name="quality" label="Graphics quality" class="quality-field" tooltip="Adjust rendering detail and performance" />
                        <ui:Toggle name="fullscreen" label="Fullscreen" class="setting-toggle" tooltip="Switch between windowed and fullscreen display" />
                        <ui:VisualElement class="slider-setting">
                            <ui:Slider name="sensitivity" label="Mouse sensitivity" low-value="0.1" high-value="3" class="setting-slider" tooltip="Adjust mouse-look speed" />
                            <ui:Label name="sensitivity-value" text="1.0x" class="slider-value" />
                        </ui:VisualElement>
                        <ui:Toggle name="invert" label="Invert vertical look" class="setting-toggle last-setting" tooltip="Moving the mouse up looks down" />
                    </ui:VisualElement>
                    <ui:VisualElement name="controls-list" class="controls-list">
                        <ui:Label text="Controls" class="controls-title" />
                        <ui:VisualElement class="control-row"><ui:Label text="W A S D" class="control-key" /><ui:Label text="Move" class="control-action" /></ui:VisualElement>
                        <ui:VisualElement class="control-row"><ui:Label text="Mouse" class="control-key" /><ui:Label text="Look around" class="control-action" /></ui:VisualElement>
                        <ui:VisualElement class="control-row"><ui:Label text="Space" class="control-key" /><ui:Label text="Jump / thrust upward" class="control-action" /></ui:VisualElement>
                        <ui:VisualElement class="control-row"><ui:Label text="Ctrl" class="control-key" /><ui:Label text="Thrust downward in zero gravity" class="control-action" /></ui:VisualElement>
                        <ui:VisualElement class="control-row"><ui:Label text="Q" class="control-key" /><ui:Label text="Toggle jetpack" class="control-action" /></ui:VisualElement>
                        <ui:VisualElement class="control-row"><ui:Label text="E / Left click" class="control-key" /><ui:Label text="Interact / grab" class="control-action" /></ui:VisualElement>
                        <ui:VisualElement class="control-row"><ui:Label text="F / T" class="control-key" /><ui:Label text="Switch past / future" class="control-action" /></ui:VisualElement>
                        <ui:VisualElement name="manual-distortion-control" class="control-row"><ui:Label text="G" class="control-key" /><ui:Label text="Distort the object you are looking at" class="control-action" /></ui:VisualElement>
                        <ui:VisualElement class="control-row"><ui:Label text="Esc / P" class="control-key" /><ui:Label text="Settings / resume" class="control-action" /></ui:VisualElement>
                        <ui:VisualElement name="checkpoint-control" class="control-row"><ui:Label text="R" class="control-key" /><ui:Label text="Reset checkpoint / replay tutorial" class="control-action" /></ui:VisualElement>
                        <ui:Label text="Gravity applies on station decks. In open space, use WASD, Space and Ctrl to fly." class="controls-hint" />
                    </ui:VisualElement>
                </ui:ScrollView>
                <ui:VisualElement class="footer">
                    <ui:Label name="settings-status" text="Saved on resume." class="save-status" />
                    <ui:VisualElement class="footer-actions">
                        <ui:Button name="defaults" text="Reset defaults" class="settings-button secondary-button" />
                        <ui:Button name="resume" text="Resume" class="settings-button primary-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
