<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="MainMenu.uss" />
    <ui:VisualElement name="main-menu" class="main-menu">
        <ui:VisualElement name="orbital-art" class="orbital-art" picking-mode="Ignore" />
        <ui:VisualElement name="menu-home" class="menu-home">
            <ui:VisualElement class="masthead">
                <ui:Label text="P / STATION OPERATIONS" class="station-brand" />
                <ui:VisualElement class="signal"><ui:VisualElement class="signal-dot" /><ui:Label text="SIGNAL LOST · 150 YEARS" class="signal-label" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:ScrollView name="home-scroll" class="home-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
                <ui:VisualElement class="hero">
                    <ui:Label text="AN ECHO ACROSS TIME" class="eyebrow" />
                    <ui:Label name="game-title" text="PARALLAX" class="game-title" />
                    <ui:Label text="One station. Two timelines." class="tagline" />
                    <ui:Label text="Step into the past. Change what remains.&#10;Restore a station adrift in time." class="description" />
                    <ui:VisualElement class="menu-actions">
                        <ui:Button name="play" text="Play" class="menu-button play-button" tooltip="Start a new game" />
                        <ui:Button name="settings" text="Settings" class="menu-button" />
                        <ui:Button name="controls" text="Controls" class="menu-button" />
                        <ui:Button name="quit" text="Quit" class="menu-button quit-button" />
                    </ui:VisualElement>
                    <ui:Label name="menu-status" text="" class="menu-status" />
                </ui:VisualElement>
            </ui:ScrollView>
            <ui:VisualElement class="menu-footer">
                <ui:Label text="FOUR SURE" class="footer-brand" />
                <ui:Label text="Explore the past. Restore the future." class="footer-caption" />
                <ui:Label text="TAB / ARROWS  Navigate     ENTER  Select" class="keyboard-hint" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
