<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="MainMenu.uss" />
    <ui:VisualElement name="main-menu" class="main-menu">
        <ui:VisualElement name="temporal-art" class="temporal-art" picking-mode="Ignore" />
        <ui:VisualElement name="menu-home" class="menu-home">
            <ui:VisualElement class="masthead">
                <ui:Label text="ARCHIVE_2176" class="station-brand" />
                <ui:VisualElement class="signal"><ui:Label text="150 YEARS OF SILENCE" class="signal-label" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:ScrollView name="home-scroll" class="home-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
                <ui:VisualElement class="hero">
                    <ui:Label name="game-title" text="PARALLAX" class="game-title" />
                    <ui:Label text="ONE LABORATORY.&#10;TWO TIMELINES." class="tagline" />
                    <ui:Label text="What happened between them?" class="description" />
                    <ui:VisualElement class="menu-actions">
                        <ui:Button name="play" text="START GAME →" class="menu-button play-button" tooltip="Start a new game" />
                        <ui:VisualElement class="secondary-actions">
                            <ui:Button name="settings" text="SETTINGS" class="menu-button secondary-button" />
                            <ui:Button name="controls" text="CONTROLS" class="menu-button secondary-button" />
                            <ui:Button name="quit" text="QUIT" class="menu-button secondary-button quit-button" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label name="menu-status" text="" class="menu-status" />
                </ui:VisualElement>
            </ui:ScrollView>
            <ui:VisualElement class="menu-footer">
                <ui:Label text="A FOUR SURE PROJECT" class="footer-brand" />
                <ui:Label text="2026 / 2176" class="footer-caption" />
                <ui:Label text="TAB / ARROWS  Navigate     ENTER  Select" class="keyboard-hint" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
