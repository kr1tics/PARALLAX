.main-menu {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgb(9, 12, 14); color: rgb(220, 228, 232);
    -unity-font-style: normal;
}
.menu-home { flex-grow: 1; padding: 32px 64px 26px 64px; }
.masthead { flex-direction: row; justify-content: space-between; align-items: center; flex-shrink: 0; padding-bottom: 20px; border-bottom-width: 1px; border-bottom-color: rgba(139, 146, 152, 0.14); }
.station-brand { font-size: 12px; letter-spacing: 1px; color: rgb(139, 146, 152); }
.signal { flex-direction: row; align-items: center; }
.signal-label { font-size: 11px; letter-spacing: 1px; color: rgb(139, 146, 152); }
.home-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.home-scroll .unity-scroll-view__content-container { flex-grow: 1; justify-content: center; }
.hero { width: 620px; max-width: 100%; flex-shrink: 0; padding-top: 28px; padding-bottom: 22px; }
.eyebrow { font-size: 11px; letter-spacing: 2px; color: rgb(139, 146, 152); margin-bottom: 10px; }
.game-title { font-size: 88px; letter-spacing: 6px; -unity-font-style: normal; margin-left: -3px; }
.tagline { font-size: 18px; margin-top: 6px; color: rgb(185, 198, 205); }
.description { font-size: 14px; color: rgb(139, 146, 152); white-space: normal; margin-top: 16px; }
.menu-actions { width: 280px; max-width: 100%; margin-top: 30px; }
.menu-button {
    height: 44px; flex-shrink: 0; margin: 0 0 8px 0; padding: 0 18px;
    background-image: none; background-color: rgba(25, 29, 32, 0.95);
    border-width: 1px; border-color: rgba(139, 146, 152, 0.3); border-radius: 2px;
    color: rgb(220, 228, 232); font-size: 16px; letter-spacing: 1px; -unity-text-align: middle-left; -unity-font-style: normal;
    transition-property: background-color, border-color, color;
    transition-duration: 0.15s;
}
.menu-button:hover { background-color: rgb(38, 44, 48); border-color: rgb(139, 146, 152); color: rgb(240, 244, 246); }
.menu-button:focus { border-color: rgb(185, 198, 205); background-color: rgb(32, 37, 41); }
.menu-button:active { background-color: rgb(48, 54, 58); }
.play-button { background-color: rgb(37, 43, 47); border-color: rgba(185, 198, 205, 0.6); }
.play-button:hover { background-color: rgb(48, 55, 60); border-color: rgb(220, 228, 232); }
.play-button:focus { border-color: rgb(220, 228, 232); background-color: rgb(43, 50, 54); }
.menu-button:disabled { opacity: 0.5; }
.quit-button { color: rgb(139, 146, 152); }
.menu-status { font-size: 12px; min-height: 18px; color: rgb(185, 198, 205); white-space: normal; margin-top: 8px; }
.menu-footer { flex-direction: row; flex-wrap: wrap; align-items: center; flex-shrink: 0; border-top-width: 1px; border-top-color: rgba(139, 146, 152, 0.14); padding-top: 16px; }
.footer-brand { font-size: 11px; letter-spacing: 2px; color: rgb(139, 146, 152); margin-right: 20px; }
.footer-caption { font-size: 11px; color: rgb(139, 146, 152); flex-grow: 1; }
.keyboard-hint { font-size: 11px; color: rgb(139, 146, 152); margin-left: 16px; }
.narrow .menu-home { padding-left: 28px; padding-right: 28px; }
.narrow .hero { width: 100%; }
.narrow .game-title { font-size: 62px; letter-spacing: 3px; }
.narrow .signal { display: none; }
.narrow .keyboard-hint { display: none; }
.short .menu-home { padding-top: 18px; padding-bottom: 14px; }
.short .masthead { padding-bottom: 12px; }
.short .hero { padding-top: 16px; padding-bottom: 10px; }
.short .game-title { font-size: 60px; }
.short .tagline { font-size: 16px; }
.short .description { margin-top: 8px; }
.short .menu-actions { margin-top: 18px; }
.short .menu-button { height: 40px; margin-bottom: 6px; }
.short .menu-footer { padding-top: 10px; }
