.main-menu {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgb(7, 12, 21); color: rgb(224, 235, 243);
}
.orbital-art { position: absolute; left: 0; top: 0; right: 0; bottom: 0; overflow: hidden; }
.menu-home { flex-grow: 1; padding: 30px 54px 24px 54px; }
.masthead { flex-direction: row; justify-content: space-between; align-items: center; flex-shrink: 0; padding-bottom: 20px; border-bottom-width: 1px; border-bottom-color: rgba(143, 188, 210, 0.16); }
.station-brand { font-size: 13px; letter-spacing: 2px; color: rgb(171, 193, 210); }
.signal { flex-direction: row; align-items: center; }
.signal-dot { width: 5px; height: 5px; border-radius: 3px; background-color: rgb(155, 143, 191); margin-right: 10px; }
.signal-label { font-size: 11px; letter-spacing: 1.5px; color: rgb(163, 156, 187); }
.home-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.home-scroll .unity-scroll-view__content-container { flex-grow: 1; justify-content: center; }
.hero { width: 520px; max-width: 100%; flex-shrink: 0; padding-top: 24px; padding-bottom: 18px; }
.eyebrow { font-size: 12px; letter-spacing: 3px; color: rgb(112, 207, 218); margin-bottom: 7px; }
.game-title { font-size: 82px; letter-spacing: 7px; -unity-font-style: bold; margin-left: -5px; }
.tagline { font-size: 24px; margin-top: 4px; color: rgb(219, 229, 238); }
.description { font-size: 15px; color: rgb(143, 163, 183); white-space: normal; margin-top: 14px; }
.menu-actions { width: 310px; max-width: 100%; margin-top: 28px; }
.menu-button {
    height: 48px; flex-shrink: 0; margin: 0 0 8px 0; padding: 0 21px;
    background-image: none; background-color: rgba(17, 30, 45, 0.94);
    border-width: 1px; border-color: rgb(42, 62, 80); border-radius: 3px;
    color: rgb(211, 225, 237); font-size: 17px; -unity-text-align: middle-left;
    transition-property: background-color, border-color, color;
    transition-duration: 0.12s;
}
.menu-button:hover { background-color: rgb(28, 49, 65); border-color: rgb(91, 150, 171); color: white; }
.menu-button:focus { border-color: rgb(155, 224, 236); border-left-width: 4px; padding-left: 18px; }
.menu-button:active { background-color: rgb(43, 74, 90); }
.play-button { background-color: rgb(141, 220, 229); border-color: rgb(141, 220, 229); color: rgb(8, 28, 40); -unity-font-style: bold; }
.play-button:hover { background-color: rgb(180, 242, 247); border-color: rgb(211, 252, 255); color: rgb(8, 28, 40); }
.play-button:focus { border-color: white; }
.play-button:active { background-color: rgb(109, 190, 204); color: rgb(8, 28, 40); }
.menu-button:disabled { opacity: 0.5; }
.quit-button { color: rgb(150, 169, 187); }
.menu-status { font-size: 13px; min-height: 18px; color: rgb(153, 220, 231); white-space: normal; margin-top: 7px; }
.menu-footer { flex-direction: row; flex-wrap: wrap; align-items: center; flex-shrink: 0; border-top-width: 1px; border-top-color: rgba(143, 188, 210, 0.16); padding-top: 16px; }
.footer-brand { font-size: 11px; letter-spacing: 2px; color: rgb(157, 181, 200); margin-right: 20px; }
.footer-caption { font-size: 12px; color: rgb(111, 137, 159); flex-grow: 1; }
.keyboard-hint { font-size: 11px; color: rgb(132, 156, 176); margin-left: 16px; }
.narrow .menu-home { padding-left: 28px; padding-right: 28px; }
.narrow .orbital-art { opacity: 0.25; }
.narrow .hero { width: 100%; }
.narrow .game-title { font-size: 64px; letter-spacing: 4px; }
.narrow .signal { display: none; }
.narrow .keyboard-hint { display: none; }
.short .menu-home { padding-top: 18px; padding-bottom: 14px; }
.short .masthead { padding-bottom: 12px; }
.short .hero { padding-top: 16px; padding-bottom: 10px; }
.short .game-title { font-size: 60px; }
.short .tagline { font-size: 20px; }
.short .description { margin-top: 8px; }
.short .menu-actions { margin-top: 18px; }
.short .menu-button { height: 40px; margin-bottom: 6px; }
.short .menu-footer { padding-top: 10px; }
